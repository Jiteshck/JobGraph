# Copy this file to .env and fill in real values. Never commit .env.

# Backend server
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Neo4j Aura (Neo4j Console -> your instance -> Connect)
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_database_password
NEO4J_DATABASE=neo4j

# Authentication (generate a long random secret; do not reuse the example)
SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Only these exact emails are allowed to be administrators.
ADMIN_EMAILS=your-admin-email@example.com

# Frontend origins used during local development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional: Google OAuth is not enabled until ID-token verification is implemented.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
